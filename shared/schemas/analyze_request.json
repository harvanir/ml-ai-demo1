{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "description": "Base64 encoded file content or file path"
    },
    "file_type": {
      "type": "string",
      "enum": ["csv", "xlsx"],
      "description": "Type of the uploaded file"
    },
    "use_ai": {
      "type": "boolean",
      "default": false,
      "description": "Whether to use AI for explanation"
    }
  },
  "required": ["file", "file_type"]
}